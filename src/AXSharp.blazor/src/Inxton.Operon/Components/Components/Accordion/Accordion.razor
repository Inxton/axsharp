<CascadingValue Value="this">
    <div class="accordion @Class">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string Class { get; set; }

    public AccordionItem? ActiveItem { get; set; } = null;
}
