                                </span>
                            </label>
                            <label for="checkbox">Checkbox</label>
                        </div>
                    </div>
                    <div class="w-2/3 ps-1 max-h-80 relative">
                        <button class="btn btn-primary absolute top-0 right-0 mt-2 me-6" @onclick="@(() => Helpers.CopyToClipboardExtractedDivContentAsync("Components/Pages/Components.razor" , "CheckboxesTailwind" , _iJSRuntime))">Copy</button>
                        <p class="whitespace-pre-wrap w-full h-full p-2 text-sm text-gray-50 bg-gray-800 rounded-lg focus:outline-none overflow-auto">
                            @Helpers.ExtractDivContent("Components/Pages/Components.razor", "CheckboxesTailwind")
                        </p>
                    </div>
                </div>
            </TabPage>
        </Tab>
    </div>

