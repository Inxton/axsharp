@using Inxton.Operon.Components.Components
@using Microsoft.JSInterop

@inject IJSRuntime _iJSRuntime

@* <h2>Components</h2> *@

<div class="" style="width: calc(100% - var(--spacing) * 50);">
    <h3 id="Headings">Headings</h3>
    <div>
        <Tab Class="justify-self-end">
            <TabPage Title="Tailwind">
                <div class="flex flex-wrap">
                    <div class="w-1/3 simple-border" id="HeadingsTailwind">
                        <h1>Heading 1</h1>
                        <h2>Heading 2</h2>
                        <h3>Heading 3</h3>
                        <h4>Heading 4</h4>
                        <h5>Heading 5</h5>
                        <h6>Heading 6</h6>
                    </div>
                    <div class="w-2/3 ps-1 max-h-80 relative">
                        <button class="btn btn-primary absolute top-0 right-0 mt-2 me-6" @onclick="@(() => Helpers.CopyToClipboardExtractedDivContentAsync("Components/Pages/Components.razor" , "HeadingsTailwind" , _iJSRuntime))">Copy</button>
                        <p class="whitespace-pre-wrap w-full h-full p-2 text-sm text-gray-50 bg-gray-800 rounded-lg focus:outline-none overflow-auto">
                            @Helpers.ExtractDivContent("Components/Pages/Components.razor", "HeadingsTailwind")
                        </p>
                    </div>
                </div>
            </TabPage>
        </Tab>
    </div>

