    <h3 id="Inputs">Inputs</h3>
    <h4 id="NormalInputs">Normal inputs</h4>
    <div>
        <Tab Class="justify-self-end">
            <TabPage Title="Tailwind">
                <div class="flex flex-wrap">
                    <div class="w-1/3 simple-border" id="NormalInputsTailwind">
                        <div class="input">
                            <label class="me-2" for="NormalInputLabel">Input label</label>
                            <input type="text" class="input" id="NormalInputLabel" />
                        </div>
                        <div class="input">
                            <label class="me-2" for="NormalInputDisabled">Input disabled</label>
                            <input type="text" class="input" disabled id="NormalInputDisabled" />
                        </div>
                        <div class="input">
                            <label class="me-2" for="NormalInputWithPlaceholder">Input with placeholder</label>
                            <input type="text" class="input" placeholder="Type something" id="NormalInputWithPlaceholder" />
                        </div>
                    </div>
                    <div class="w-2/3 ps-1 max-h-80 relative">
                        <button class="btn btn-primary absolute top-0 right-0 mt-2 me-6" @onclick="@(() => Helpers.CopyToClipboardExtractedDivContentAsync("Components/Pages/Components.razor" , "NormalInputsTailwind" , _iJSRuntime))">Copy</button>
                        <p class="whitespace-pre-wrap w-full h-full p-2 text-sm text-gray-50 bg-gray-800 rounded-lg focus:outline-none overflow-auto">
                            @Helpers.ExtractDivContent("Components/Pages/Components.razor", "NormalInputsTailwind")
                        </p>
                    </div>
                </div>
            </TabPage>
        </Tab>
    </div>

    <h4 id="FloatingInputs">Floating inputs</h4>
    <div>
        <Tab Class="justify-self-end">
            <TabPage Title="Component">
                <div class="flex flex-wrap">
                    <div class="w-1/3 simple-border" id="FloatingInputsComponent">
                        @code {
        private string _baseInputString = "string";
        private double _baseInputDouble = 2;
                        }
                        <BaseInput @bind-Value="_baseInputString" Label="String" />
                        <BaseInput @bind-Value="_baseInputDouble" Label="Double" />
                        <BaseInput @bind-Value="_baseInputDouble" Label="Validator Bool" Validator="c => c >= 5 && c <= 7" InvalidMessage="Value must be between 5-7" />
                    </div>
                    <div class="w-2/3 ps-1 max-h-80 relative">
                        <button class="btn btn-primary absolute top-0 right-0 mt-2 me-6" @onclick="@(() => Helpers.CopyToClipboardExtractedDivContentAsync("Components/Pages/Components.razor" , "FloatingInputsComponent" , _iJSRuntime))">Copy</button>
                        <p class="whitespace-pre-wrap w-full h-full p-2 text-sm text-gray-50 bg-gray-800 rounded-lg focus:outline-none overflow-auto">
                            @Helpers.ExtractDivContent("Components/Pages/Components.razor", "FloatingInputsComponent")
                        </p>
                    </div>
                </div>
            </TabPage>
            <TabPage Title="Tailwind">
                <div class="flex flex-wrap">
                    <div class="w-1/3 simple-border" id="FloatingInputsTailwind">
                        <div class="input-floating">
                            <input class="peer" placeholder="" />
                            <label>Input label</label>
                        </div>
                        <div class="input-floating">
                            <input class="peer" disabled value="Value" />
                            <label>Input disabled</label>
                        </div>
                    </div>
                    <div class="w-2/3 ps-1 max-h-80 relative">
                        <button class="btn btn-primary absolute top-0 right-0 mt-2 me-6" @onclick="@(() => Helpers.CopyToClipboardExtractedDivContentAsync("Components/Pages/Components.razor" , "FloatingInputsTailwind" , _iJSRuntime))">Copy</button>
                        <p class="whitespace-pre-wrap w-full h-full p-2 text-sm text-gray-50 bg-gray-800 rounded-lg focus:outline-none overflow-auto">
                            @Helpers.ExtractDivContent("Components/Pages/Components.razor", "FloatingInputsTailwind")
                        </p>
                    </div>
                </div>
                <p class="text-md">For proper functionality, the input must have an empty placeholder.</p>
            </TabPage>
        </Tab>
    </div>

    <h4 id="Checkboxes">Checkboxes</h4>
