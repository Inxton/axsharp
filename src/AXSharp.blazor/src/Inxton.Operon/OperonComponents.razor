                    <div class="w-2/3 ps-1 max-h-80 relative">
                        <button class="btn btn-primary absolute top-0 right-0 mt-2 me-6" @onclick="@(() => Helpers.CopyToClipboardExtractedDivContentAsync("Components/Pages/Components.razor" , "CheckboxesComponent" , _iJSRuntime))">Copy</button>
