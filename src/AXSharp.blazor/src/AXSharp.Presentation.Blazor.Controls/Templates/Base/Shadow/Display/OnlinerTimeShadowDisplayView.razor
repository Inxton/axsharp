@namespace AXSharp.Presentation.Blazor.Controls.Templates
@using System.Globalization;
@inherits TemplateBaseShadow<TimeSpan>

<TemplateView Symbol="@OnlinerSymbol" FailureReason="@Onliner.AccessStatus.FailureReason">
    <Operon.Components.Pickers.TimeSpanPicker @bind-Value="@InputValue" Label="@GetLabel()" IsReadOnly="true" AccessStatus="@AccessStatus" />
</TemplateView>

@code
{
    private TimeSpan? InputValue
    {
        get
        {
            return Onliner.Shadow;
        }
        set
        {
            if (value != null)
                Onliner.Shadow = (TimeSpan)value;
        }
    }
}