@namespace AXSharp.Presentation.Blazor.Controls.Templates
@using System.Globalization;
@inherits TemplateBaseShadow<DateTime>

<TemplateView Symbol="@OnlinerSymbol" FailureReason="@Onliner.AccessStatus.FailureReason">
    <Operon.Components.Pickers.DateTimePicker @bind-Value="@InputValue" Label="@GetLabel()" IsReadOnly="@IsReadOnly" AccessStatus="@AccessStatus" />
</TemplateView>

@code
{
    private DateTime? InputValue
    {
        get
        {
            return Onliner.Shadow;
        }
        set
        {
            if (value != null)
                Onliner.Shadow = (DateTime)value;
        }
    }
}
