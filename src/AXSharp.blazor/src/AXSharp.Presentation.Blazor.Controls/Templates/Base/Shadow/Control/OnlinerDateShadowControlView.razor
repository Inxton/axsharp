@namespace AXSharp.Presentation.Blazor.Controls.Templates
@using System.Globalization;
@inherits TemplateBaseShadow<DateOnly>

<TemplateView Symbol="@OnlinerSymbol" FailureReason="@Onliner.AccessStatus.FailureReason">
    <Operon.Components.Pickers.DateOnlyPicker @bind-Value="@InputValue" Label="@GetLabel()" IsReadOnly="@IsReadOnly" AccessStatus="@AccessStatus" OnFocusIn="() => HasFocus = true" OnFocusOut="() => HasFocus = false" />
</TemplateView>

@code
{
    private DateOnly? InputValue
    {
        get
        {
            return Onliner.Shadow;
        }
        set
        {
            if (value != null)
                Onliner.Shadow = (DateOnly)value;
        }
    }
}
