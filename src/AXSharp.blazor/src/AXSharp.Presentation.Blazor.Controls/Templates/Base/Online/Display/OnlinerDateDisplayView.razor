@namespace AXSharp.Presentation.Blazor.Controls.Templates
@using System.Globalization
@inherits TemplateBaseOnline<DateOnly>

<TemplateView OnlinerSymbol="@OnlinerSymbol" FailureReason="@Onliner.AccessStatus.FailureReason" ToolTipOrHumanReadable="@ToolTipOrHumanReadable" ShowToolTipOrHumanReadable="@ShowToolTipOrHumanReadable" Symbol="@Symbol" ShowSymbol="@ShowSymbol">
    <Operon.Components.Pickers.DateOnlyPicker @bind-Value="@InputValue" Label="@GetLabel()" IsReadOnly="true" AccessStatus="@AccessStatus" OnFocusIn="() => HasFocus = true" OnFocusOut="() => HasFocus = false" />
</TemplateView>

@code
{
    private DateOnly? InputValue
    {
        get
        {
            return Onliner.Cyclic;
        }
        set
        {
            if (value != null)
                Onliner.Cyclic = (DateOnly)value;
        }
    }
}
