@namespace AXSharp.Presentation.Blazor.Controls.Templates
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using AXSharp.Presentation.Blazor.Controls.Templates
@inherits TemplateBaseOnline<TimeSpan>

<TemplateView Symbol="@OnlinerSymbol" FailureReason="@Onliner.AccessStatus.FailureReason">
    <Operon.Components.Pickers.TimeSpanPicker @bind-Value="@InputValue" Label="@GetLabel()" IsReadOnly="@IsReadOnly" AccessStatus="@AccessStatus" />
</TemplateView>

@code
{
    private TimeSpan? InputValue
    {
        get
        {
            return Value;
        }
        set
        {
            if (value != null)
                Value = (TimeSpan)value;
        }
    }
}
