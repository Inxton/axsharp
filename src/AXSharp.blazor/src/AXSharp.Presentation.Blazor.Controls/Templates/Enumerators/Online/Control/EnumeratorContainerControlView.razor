@namespace AXSharp.Presentation.Blazor.Controls.Templates
@typeparam T
@inherits EnumeratorsBaseOnline<T>


 <TemplateView Symbol="@OnlinerSymbol" FailureReason="@Onliner.AccessStatus.FailureReason">
     <label for="@ComponentId"  >@Onliner.AttributeName</label>

     <select
         id="@ComponentId"
         class="base-select @AccessStatus"
         @bind="Value"
         disabled="@IsReadOnly"
        >
         @foreach (var name in Names)
         {
             <option value="@EnumToIntConverter.ConvertBack(name,null,null,null)">
                 @name
             </option>
         }
     </select>
     
 </TemplateView>