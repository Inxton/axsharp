@namespace AXSharp.Presentation.Blazor.Controls.Templates
@typeparam T
@inherits EnumeratorsBaseShadow<T>

<TemplateView Symbol="@OnlinerSymbol" FailureReason="@Onliner.AccessStatus.FailureReason">
    <label class="base-input-label" for="@ComponentId" >@Onliner.AttributeName</label>
    <input id="@ComponentId"
            class="base-select @AccessStatus"
            readonly="readonly"
            style=@(IsReadOnly? "" : "background-color:transparent")
            value="@EnumToIntConverter.Convert(@Onliner.Shadow,null,null,null)  "
            data-bs-toggle="tooltip" 
            data-bs-placement="top"
            data-bs-custom-class="custom-tooltip"
            data-bs-title="@ToolTipText"/>
</TemplateView>