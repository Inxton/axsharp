@namespace AXSharp.Presentation.Blazor.Controls.Templates
@typeparam T
@inherits EnumeratorsBaseShadow<T>

<TemplateView OnlinerSymbol="@OnlinerSymbol" FailureReason="@Onliner.AccessStatus.FailureReason" ToolTipOrHumanReadable="@ToolTipOrHumanReadable" Symbol="@Symbol">
    <div class="select-group">
        <label for="@ComponentId">@Onliner.AttributeName</label>

        <select id="@ComponentId"
                class="min-w-6 @AccessStatus"
                readonly="readonly"
                disabled="disabled">

            <option value="@EnumToIntConverter.Convert(@Onliner.Shadow, null, null, null)" selected>
                @EnumToIntConverter.Convert(@Onliner.Shadow, null, null, null)
            </option>
        </select>
    </div>
</TemplateView>