@namespace AXSharp.Presentation.Blazor.Controls.Templates
@typeparam T
@inherits EnumeratorsBaseShadow<T>

<TemplateView Symbol="@OnlinerSymbol" FailureReason="@Onliner.AccessStatus.FailureReason">
    <label class="me-2" for="@ComponentId">@Onliner.AttributeName</label>

    <input id="@ComponentId"
            class="select min-w-6 @AccessStatus"
            value="@EnumToIntConverter.Convert(@Onliner.Shadow,null,null,null)"
            readonly="readonly" />
</TemplateView>