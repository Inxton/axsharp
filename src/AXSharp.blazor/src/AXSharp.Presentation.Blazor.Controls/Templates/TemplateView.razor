@namespace AXSharp.Presentation.Blazor.Controls.Templates
<div name="@OnlinerSymbol">
    @ChildContent
    <div class="invalid-feedback">
        @FailureReason
    </div>
    @if (ShowToolTipOrHumanReadable)
    {
        <div class="feedback">
            @ToolTipOrHumanReadable
        </div>
    }
    @if (ShowSymbol)
    {
        <div class="feedback">
            @Symbol
        </div>
    }
</div>

@code
{
    [Parameter]
    public string OnlinerSymbol { get; set; }
    [Parameter]
    public string FailureReason { get; set; }
    [Parameter]
    public string ToolTipOrHumanReadable { get; set; }
    [Parameter]
    public bool ShowToolTipOrHumanReadable { get; set; } = false;
    [Parameter]
    public string Symbol { get; set; }
    [Parameter]
    public bool ShowSymbol { get; set; } = false;
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}