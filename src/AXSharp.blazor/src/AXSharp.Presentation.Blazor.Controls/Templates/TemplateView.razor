@namespace AXSharp.Presentation.Blazor.Controls.Templates
<div name="@OnlinerSymbol">
    @ChildContent
    <div class="invalid-feedback">
        @FailureReason
    </div>
    @if (DevSettings.ShowToolTipOrHumanReadable)
    {
        <div class="feedback">
            @ToolTipOrHumanReadable
        </div>
    }
    @if (DevSettings.ShowSymbol)
    {
        <div class="feedback">
            @Symbol
        </div>
    }
</div>

@code
{
    [Parameter]
    public string OnlinerSymbol { get; set; }
    [Parameter]
    public string FailureReason { get; set; }
    [Parameter]
    public string ToolTipOrHumanReadable { get; set; }
    [Parameter]
    public string Symbol { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}