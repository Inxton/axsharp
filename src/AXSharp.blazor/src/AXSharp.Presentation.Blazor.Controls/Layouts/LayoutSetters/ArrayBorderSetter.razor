@if (IsArray)
{
    <div data-array-border-setter class="flex flex-wrap card p-2 my-6">
        <h4>@Name</h4>
        @ChildContent
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public bool IsArray { get; set; }
    [Parameter]
    public string Name { get; set; }
}