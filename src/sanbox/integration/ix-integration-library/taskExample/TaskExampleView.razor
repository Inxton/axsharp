@namespace AXSharp.Presentation.Blazor.Controls.Templates
@using AXSharp.Connector
@inherits RenderableComplexComponentBase<TaskExample>

<div class="mb-4">
    @if (IsTaskRunning)
    {
        <div class="inline-flex items-center px-4 py-2 bg-blue-500 text-white rounded-md">
            <span class="animate-spin mr-2 h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
            <span>@Component.AttributeName</span>
            <button class="ml-2 text-white hover:text-gray-200" type="button" @onclick="@AbortTask">
                <span class="sr-only">Close</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }
    else if (IsTaskAborted)
    {
        <button class="inline-flex items-center px-4 py-2 bg-yellow-500 text-white rounded-md hover:bg-yellow-600 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-opacity-50" 
                type="button" 
                @onclick="@ResumeTask">
            <span>@Component.AttributeName</span>
        </button>
    }
    else
    {
        <button class="inline-flex items-center px-4 py-2 bg-green-500 text-white rounded-md hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50" 
                type="button" 
                @onclick="@StartTask">
            <span>@Component.AttributeName</span>
        </button>
    }
</div>

@code {
    private bool IsTaskRunning => Component.taskRun.Cyclic;
    private bool IsTaskAborted => Component.taskCancel.Cyclic;

    private void StartTask()
    {
        Component.taskRun.Cyclic = true;
    }

    private void AbortTask()
    {
        Component.taskCancel.Cyclic = true;
    }

    private void ResumeTask()
    {
        Component.taskCancel.Cyclic = false;
    }
}
