@page "/swapping/onlineshadowplain"

<div class="space-x-4">
    <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50" 
            @onclick="()=> ShadowToOnline()">
        ShadowToOnline
    </button>
    <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50" 
            @onclick="()=> OnlineToShadow()">
        OnlineToShadow
    </button>
    <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50" 
            @onclick="()=> PlainToOnline()">
        Plain to online
    </button>
    <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50" 
            @onclick="()=> PlainToShadow()">
        Plain to shadow
    </button>
</div>

<SwappingElement PlainValue="@PlainValue"
                 OnlineValue="@Entry.Plc.MAINC.Time.shadow_onliner.Cyclic"
                 ShadowValue="@Entry.Plc.MAINC.Time.shadow_onliner.Shadow"
                 Updated="Updated" />

@code {
    private DateTime PlainValue;

    private void ShadowToOnline()
    {
        Entry.Plc.MAINC.Time.shadow_onliner.FromShadow();
    }

    private void OnlineToShadow()
    {
        Entry.Plc.MAINC.Time.shadow_onliner.ToShadow();
    }

    private void PlainToOnline()
    {
        Entry.Plc.MAINC.Time.shadow_onliner.Cyclic = PlainValue;
    }

    private void PlainToShadow()
    {
        Entry.Plc.MAINC.Time.shadow_onliner.Shadow = PlainValue;
    }

    protected override void OnInitialized()
    {
        PlainValue = Entry.Plc.MAINC.Time.shadow_onliner.Cyclic;
        base.OnInitialized();
    }

    private void Updated()
    {
        PlainValue = Entry.Plc.MAINC.Time.shadow_onliner.Cyclic;
    }
}
